{
   "id": "intersight_config_orgs_netflow_configuration_policies#",
   "$schema": "http://json-schema.org/draft-07/schema#",
   "title": "EasyUCS intersight config orgs netflow_configuration_policies section",
   "description": "EasyUCS intersight config orgs netflow_configuration_policies section JSON schema",
   "type": "object",
   "properties": {
      "comment": {
         "description": "NetFlow Configuration Policy Comments",
         "type": "string",
         "default": ""
      },
      "descr": {
         "description": "NetFlow Configuration Policy Description",
         "type": "string",
         "default": "",
         "pattern": "^$|^[a-zA-Z0-9]+[\\x00-\\xFF]*$",
         "maxLength": 1024
      },
      "name": {
         "description": "NetFlow Configuration Policy Name",
         "type": "string",
         "default": "",
         "pattern": "^[a-zA-Z0-9_.:-]{1,64}$"
      },
      "tags": {
         "description": "NetFlow Configuration Policy Tags",
         "type": "array",
         "items": {
            "description": "NetFlow Configuration Policy Tag",
            "type": "object",
            "properties": {
               "key": {
                  "description": "NetFlow Configuration Policy Tag Key",
                  "type": "string",
                  "default": "",
                  "minLength": 1,
                  "maxLength": 128
               },
               "value": {
                  "description": "NetFlow Configuration Policy Tag Value",
                  "type": "string",
                  "default": "",
                  "minLength": 0,
                  "maxLength": 256
               }
            },
            "additionalProperties": false,
            "required": [
               "key"
            ]
         },
         "minItems": 1
      },
      "flow_definitions": {
         "description": "NetFlow Configuration Policy - Flow Record Definitions",
         "type": "array",
         "items": {
            "description": "NetFlow Configuration Policy - Flow Record Definition",
            "type": "object",
            "properties": {
               "name": {
                  "description": "NetFlow Configuration Policy - Flow Record Name",
                  "type": "string",
                  "default": "",
                  "pattern": "^[a-zA-Z0-9_.:-]{1,64}$"
               },
               "record_type": {
                  "description": "NetFlow Configuration Policy - Flow Record Type",
                  "type": "string",
                  "default": "IPv4",
                  "enum": [
                     "L2",
                     "IPv4",
                     "IPv6",
                     "Invalid"
                  ]
               },
               "keys": {
                  "description": "NetFlow Configuration Policy - Flow Record Key Fields",
                  "type": "array",
                  "items": {
                     "description": "NetFlow Configuration Policy - Flow Record Key Field",
                     "type": "string",
                     "enum": [
                        "destination_ip_address",
                        "destination_mac_address",
                        "destination_port",
                        "ether_type",
                        "protocol",
                        "source_ip_address",
                        "source_mac_address",
                        "source_port",
                        "tos"
                     ]
                  },
                  "minItems": 1
               },
               "non_keys": {
                  "description": "NetFlow Configuration Policy - Flow Record Non-Key Fields",
                  "type": "array",
                  "items": {
                     "description": "NetFlow Configuration Policy - Flow Record Non-Key Field",
                     "type": "string",
                     "enum": [
                        "byte_counters",
                        "first_system_time",
                        "last_system_time",
                        "packet_counters"
                     ]
                  },
                  "minItems": 1
               }
            },
            "additionalProperties": false,
            "required": [
               "name",
               "record_type"
            ]
         },
         "minItems": 1
      },
      "flow_exporters": {
         "description": "NetFlow Configuration Policy - Flow Exporters",
         "type": "array",
         "items": {
            "description": "NetFlow Configuration Policy - Flow Exporter",
            "type": "object",
            "properties": {
               "name": {
                  "description": "NetFlow Configuration Policy - Flow Exporter Name",
                  "type": "string",
                  "default": "",
                  "pattern": "^[a-zA-Z0-9_.:-]{1,64}$"
               },
               "flow_collector": {
                  "description": "NetFlow Configuration Policy - Flow Exporter Collector Settings",
                  "type": "object",
                  "properties": {
                     "destination_ip_address": {
                        "description": "NetFlow Configuration Policy - Flow Exporter Destination IP Address",
                        "type": "string"
                     },
                     "udp_port": {
                        "description": "NetFlow Configuration Policy - Flow Exporter UDP Port",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                     },
                     "gateway_ip_address": {
                        "description": "NetFlow Configuration Policy - Flow Exporter Gateway IP Address",
                        "type": "string"
                     },
                     "dscp": {
                        "description": "NetFlow Configuration Policy - Flow Exporter DSCP",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 63
                     }
                  },
                  "additionalProperties": false
               },
               "timeouts": {
                  "description": "NetFlow Configuration Policy - Flow Exporter Timeouts",
                  "type": "object",
                  "properties": {
                     "template_data_timeout": {
                        "description": "NetFlow Configuration Policy - Template Data Timeout (seconds)",
                        "type": "integer",
                        "minimum": 60,
                        "maximum": 86400
                     },
                     "option_exporter_stats_timeout": {
                        "description": "NetFlow Configuration Policy - Option Exporter Stats Timeout (seconds)",
                        "type": "integer",
                        "minimum": 60,
                        "maximum": 86400
                     },
                     "option_interface_table_timeout": {
                        "description": "NetFlow Configuration Policy - Option Interface Table Timeout (seconds)",
                        "type": "integer",
                        "minimum": 60,
                        "maximum": 86400
                     }
                  },
                  "additionalProperties": false
               },
               "exporter_interfaces": {
                  "description": "NetFlow Configuration Policy - Flow Exporter Source Interface",
                  "type": "object",
                  "properties": {
                     "vlan_id": {
                        "description": "NetFlow Configuration Policy - Flow Exporter Source VLAN ID",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4095
                     },
                     "switch_a_ip": {
                        "description": "NetFlow Configuration Policy - Flow Exporter Switch A IP Address",
                        "type": "string",
                        "pattern": "^([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
                     },
                     "switch_a_subnet_mask": {
                        "description": "NetFlow Configuration Policy - Flow Exporter Switch A Subnet Mask",
                        "type": "string",
                        "pattern": "^([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
                     },
                     "switch_b_ip": {
                        "description": "NetFlow Configuration Policy - Flow Exporter Switch B IP Address",
                        "type": "string",
                        "pattern": "^([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
                     },
                     "switch_b_subnet_mask": {
                        "description": "NetFlow Configuration Policy - Flow Exporter Switch B Subnet Mask",
                        "type": "string",
                        "pattern": "^([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$"
                     }
                  },
                  "additionalProperties": false
               }
            },
            "additionalProperties": false,
            "required": [
               "name"
            ]
         },
         "minItems": 1
      },
      "flow_monitors": {
         "description": "NetFlow Configuration Policy - Flow Monitors",
         "type": "array",
         "items": {
            "description": "NetFlow Configuration Policy - Flow Monitor",
            "type": "object",
            "properties": {
               "name": {
                  "description": "NetFlow Configuration Policy - Flow Monitor Name",
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:-]{1,64}$"
               },
               "flow_record": {
                  "description": "NetFlow Configuration Policy - Flow Monitor Flow Record",
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:-]{1,64}$"
               },
               "flow_exporters": {
                  "description": "NetFlow Configuration Policy - Flow Monitor Flow Exporters",
                  "type": "array",
                  "items": {
                     "description": "NetFlow Configuration Policy - Flow Monitor Flow Exporter Name",
                     "type": "string",
                     "pattern": "^[a-zA-Z0-9_.:-]{1,64}$"
                  },
                  "minItems": 1
               }
            },
            "additionalProperties": false,
            "required": [
               "name"
            ]
         },
         "minItems": 1
      }
   },
   "additionalProperties": false,
   "required": [
      "name"
   ]
}

